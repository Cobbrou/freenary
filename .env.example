# Generated by `bun run env:sync` from packages/env/src/schema.ts. Do not edit.
#
# Copy this file to `.env`. `docker-compose.yml` reads every line of it, and
# the development stack reads it too, through an optional `env_file`.

# --- Core and secrets ---
# The two values below are development values. A real instance replaces both;
# `docker compose up` refuses to start with either one empty.
#   openssl rand -hex 16   # database password
#   openssl rand -hex 32   # BETTER_AUTH_SECRET, 32 characters or more

# The database password. It fills both the container password and the `DATABASE_URL` of `migrate` and `server`.
POSTGRES_PASSWORD=password
# Signs session cookies, encrypts two-factor secrets and backup codes, and signs the bank connection state.
BETTER_AUTH_SECRET=dev_secret_change_me_at_least_32chars

# --- Public origins and cookies ---
# The origins a browser reaches. Both default to localhost outside production,
# which works on the machine that runs the stack and nowhere else. Set both for
# any other host, with `https://` once TLS sits in front.

# The parent domain the API server and the web app share, for example `.example.com`. It keeps the session cookie at `SameSite=Lax` and adds `Domain`.
# AUTH_COOKIE_DOMAIN=.example.com
# The public origin of the API server. It builds the sign-in callback URLs and decides the cookie `Secure` flag.
# BETTER_AUTH_URL=https://api.example.com
# The public origin of the web app. It sets the CORS allow-list, the passkey relying party and the cookie same-site test.
# CORS_ORIGIN=https://app.example.com
# The addresses or CIDR ranges of the proxies in front of the API server. Rate limits key on the caller address behind them.
# TRUSTED_PROXIES=10.0.0.0/24,192.0.2.10

# --- Database ---

# The PostgreSQL connection string the Prisma driver adapter opens.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/freenary

# --- Email ---
# Email delivery — one-time codes, address confirmation and password reset.
# With no provider Freenary hides those flows instead of offering them.
# For development, `bun run dev:mail` starts a Mailpit inbox and needs no
# mail account.

# The envelope sender, for example `Freenary <no-reply@example.com>`.
# EMAIL_FROM=Freenary <no-reply@example.com>
# Picks the email adapter. Unset means no email provider is connected.
# EMAIL_PROVIDER=smtp
# The Resend API key.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The mail host.
# SMTP_HOST=smtp.example.com
# The SMTP password.
# SMTP_PASSWORD=a-mail-account-password
# The mail port.
# SMTP_PORT=587
# `true` picks implicit TLS. `false` picks STARTTLS.
# SMTP_SECURE=false
# The SMTP user.
# SMTP_USER=no-reply@example.com

# --- Sign-in ---
# Sign-in providers — each optional and inert while unset, so a deployment that
# configures none of them shows none of the buttons.
# Google: https://console.cloud.google.com/apis/credentials
#   Redirect URI: $BETTER_AUTH_URL/api/auth/callback/google
# Apple: https://developer.apple.com/account/resources/identifiers
#   Redirect URI: $BETTER_AUTH_URL/api/auth/callback/apple
# Any OpenID Connect provider (Authentik, Keycloak, Zitadel, Entra, …).
#   Redirect URI: $BETTER_AUTH_URL/api/auth/callback/oidc

# Sets the Apple identity-token audience.
# APPLE_APP_BUNDLE_IDENTIFIER=com.example.freenary
# With `APPLE_CLIENT_SECRET`, it adds the Apple button.
# APPLE_CLIENT_ID=com.example.freenary
# With `APPLE_CLIENT_ID`, it adds the Apple button.
# APPLE_CLIENT_SECRET=eyJhbGciOiJFUzI1NiIsImtpZCI6...
# `true` checks each new password against Have I Been Pwned.
# AUTH_PASSWORD_BREACH_CHECK=true
# With `GOOGLE_CLIENT_SECRET`, it adds the Google button.
# GOOGLE_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com
# With `GOOGLE_CLIENT_ID`, it adds the Google button.
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# With `OIDC_DISCOVERY_URL`, it adds the single sign-on button.
# OIDC_CLIENT_ID=freenary
# The client secret.
# OIDC_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# With `OIDC_CLIENT_ID`, it adds the single sign-on button. Point it at the `.well-known/openid-configuration` document.
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# The button label.
# OIDC_PROVIDER_NAME=Example SSO
# Comma-separated extra scopes. Freenary always asks for `openid`, `email` and `profile`.
# OIDC_SCOPES=groups

# --- Bank providers ---
# Bank provider — leave every value unset to skip the bank-connection step.
# Powens: create a domain and a client application at https://console.powens.com,
# whitelist https://<web origin>/callback/powens as a redirect URL of that client.
# Enable Banking: register an app at https://enablebanking.com and download the
# private key .pem file. It needs BANKING_PROVIDER=enable-banking.

# Picks the provider a new bank connection uses: `powens` or `enable-banking`.
# BANKING_PROVIDER=powens
# The Enable Banking application identifier.
# ENABLE_BANKING_APP_ID=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
# The Enable Banking PEM private key.
# ENABLE_BANKING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----
# The Powens client identifier.
# POWENS_CLIENT_ID=12345678
# The Powens client secret.
# POWENS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# The Powens domain, for example `acme-sandbox`. A value that ends with `.biapi.pro` also works.
# POWENS_DOMAIN=acme-sandbox

# --- Assistant ---
# AI assistant — optional. Any OpenAI-compatible chat-completions endpoint: a
# gateway (OpenRouter, Groq), OpenAI itself, or a local runtime (Ollama, vLLM).
# Set, it is the default in the model picker on Home; the picker always also
# offers models that run in the reader's own browser (WebGPU).

# The key for that endpoint.
# AI_API_KEY=sk-...
# The base URL of the chat-completions endpoint, with its version path.
# AI_BASE_URL=https://openrouter.ai/api/v1
# The model id as the endpoint names it.
# AI_MODEL=anthropic/claude-3.5-sonnet

# --- Categorisation ---
# Transaction classifier — optional. It sends a normalised descriptor, merchant
# and payment facts (never an amount, date, IBAN or account) to the endpoint of
# TRANSACTION_CLASSIFIER, and to the TRANSACTION_CLASSIFIER_FALLBACK endpoint
# when that answer is weak. Answers are cached per merchant and per model, so a
# merchant is asked about once. Each slot names a protocol and its own URL:
# `system-one` (TypeSafe Jev, Mapika/decider-2b, Laya), `llm` (any
# OpenAI-compatible endpoint, local or a gateway) or `zero-shot` (Hugging Face).
# A URL on your own hardware keeps the descriptors on it, which is the
# recommendation, not a requirement.
# DICTIONARY_PUBLIC_KEY is the Ed25519 public key PEM from: bun run generate:key

# An Ed25519 public key in PEM form. A value turns signature checks of the merchant dictionary on.
# DICTIONARY_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCow...\n-----END PUBLIC KEY-----
# Names the protocol of the classifier asked first for a merchant no rule, no dictionary entry and no correction knows. `system-one` posts the TypeSafe `/v1/systemone` shape, which TypeSafe Jev, `Mapika/decider-2b` and Laya all answer. `llm` posts an OpenAI-compatible chat completion. `zero-shot` posts the Hugging Face zero-shot-classification shape.
# TRANSACTION_CLASSIFIER=system-one
# The key that endpoint expects, if it expects one.
# TRANSACTION_CLASSIFIER_API_KEY=sk-...
# The confidence under which the answer of the first classifier goes to `TRANSACTION_CLASSIFIER_FALLBACK`. The default is the confidence the pipeline needs to write a category without asking the reader.
# TRANSACTION_CLASSIFIER_ESCALATE_BELOW=0.85
# Names the protocol of the classifier asked when the first one abstains or answers under `TRANSACTION_CLASSIFIER_ESCALATE_BELOW`. The higher-confidence answer of the two wins, and each is cached against its own model.
# TRANSACTION_CLASSIFIER_FALLBACK=llm
# The key the fallback endpoint expects, if it expects one.
# TRANSACTION_CLASSIFIER_FALLBACK_API_KEY=sk-or-...
# Names the model the fallback endpoint serves. It is part of the cache key, so a change asks every merchant again.
# TRANSACTION_CLASSIFIER_FALLBACK_MODEL=qwen/qwen3-8b
# Sharpens or flattens the answer distribution of the fallback before its confidence is measured. It follows the same rule as `TRANSACTION_CLASSIFIER_TEMPERATURE`.
# TRANSACTION_CLASSIFIER_FALLBACK_TEMPERATURE=1.3
# The URL of the fallback endpoint. The `llm` protocol appends `/chat/completions` to it, and the other two post to it as it is.
# TRANSACTION_CLASSIFIER_FALLBACK_URL=https://openrouter.ai/api/v1
# Names the model that endpoint serves. It is part of the cache key, so a change asks every merchant again.
# TRANSACTION_CLASSIFIER_MODEL=decider-2b-v10
# Sharpens or flattens the answer distribution before the confidence is measured. At 1 a `system-one` endpoint keeps the statistic it reports, and the other two protocols still measure the distribution themselves.
# TRANSACTION_CLASSIFIER_TEMPERATURE=1.3
# The URL of the endpoint the classifier asks. The `llm` protocol appends `/chat/completions` to it, and the other two post to it as it is. It reaches a server you run or one somebody else hosts.
# TRANSACTION_CLASSIFIER_URL=http://decider:8000/v1/systemone

# --- Images and host ports ---

# The tag of both published images.
FREENARY_VERSION=latest
# The host port of the API server.
# SERVER_PORT=3000
# The host port of the web app.
# WEB_PORT=3001
# The host port of PostgreSQL. Compose publishes `127.0.0.1:<POSTGRES_PORT>:5432`, so the loopback interface alone gets it.
# POSTGRES_PORT=5432

# --- Development only ---

# The API server hostname. It fills `BETTER_AUTH_URL`.
# SERVER_HOST=server.freenary.localhost
# The web app hostname. It fills `CORS_ORIGIN`.
# WEB_HOST=web.freenary.localhost
# The documentation hostname, in the Traefik route alone.
# DOCS_HOST=docs.freenary.localhost
# The Mailpit inbox hostname, in the Traefik route alone. It applies to `bun run dev:mail`.
# MAIL_HOST=mail.freenary.localhost
