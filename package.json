{
  "name": "freenary",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "effect": "4.0.0-rc.115",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "elysia": "^1.4.29",
      "@orpc/server": "^1.14.12",
      "@orpc/openapi": "^1.14.12",
      "@orpc/zod": "^1.14.12",
      "better-auth": "1.7.1",
      "evlog": "^2.22.4",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@orpc/client": "^1.14.12",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:data": "turbo run build:data -F @freenary/api --",
    "check-types": "turbo run check-types",
    "docs:check": "turbo run docs:check",
    "env:sync": "bun scripts/env-sync.ts",
    "env:check": "bun scripts/env-sync.ts --check",
    "check:fsd": "turbo run lint:fsd",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @freenary/db --",
    "db:studio": "turbo run db:studio -F @freenary/db --",
    "db:generate": "turbo run db:generate -F @freenary/db --",
    "db:migrate": "turbo run db:migrate -F @freenary/db --",
    "db:start": "docker compose up -d postgres",
    "db:watch": "docker compose up postgres",
    "db:stop": "docker compose stop postgres",
    "db:down": "docker compose down postgres",
    "dev:up": "bun scripts/dev.ts up --build --watch",
    "dev:mail": "bun scripts/dev.ts --mail up --build --watch",
    "dev:down": "bun scripts/dev.ts down",
    "dev:logs": "bun scripts/dev.ts logs -f",
    "dev:reset": "bun scripts/dev.ts reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "deploy:dokploy": "bun scripts/dokploy-import.ts",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "dependencies": {
    "@freenary/env": "workspace:*",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@freenary/config": "workspace:*",
    "@shadcn/lint": "^0.1.1",
    "@types/bun": "catalog:",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxslop": "^0.1.1",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.14",
  "registries": {
    "@fluid": "https://www.fluidfunctionalism.com/r/{name}.json"
  }
}
