FROM oven/bun:1-slim

WORKDIR /app

COPY package.json bun.lock tsconfig.json turbo.json ./

COPY apps/server/package.json ./apps/server/
COPY apps/web/package.json ./apps/web/
COPY apps/fumadocs/package.json ./apps/fumadocs/

COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/config/package.json ./packages/config/
COPY packages/config/tsconfig.base.json ./packages/config/
COPY packages/db/package.json ./packages/db/
COPY packages/email/package.json ./packages/email/
COPY packages/env/package.json ./packages/env/
COPY packages/instance-config/package.json ./packages/instance-config/
COPY packages/ui/package.json ./packages/ui/

RUN bun install --frozen-lockfile --ignore-scripts

# Source baked in (watch syncs changes on top); node_modules excluded via .dockerignore
COPY . .

# Generate Prisma client — skipped by --ignore-scripts above.
# Prisma config reads DATABASE_URL; the generate step needs only the schema, not a
# live database, so a dummy value satisfies the config loader.
RUN cd packages/db && DATABASE_URL=postgresql://x@x/x bun x prisma generate

