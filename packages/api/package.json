{
  "name": "@freenary/api",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build:data": "bun scripts/download-data.ts || bun run build:data:generate",
    "build:data:generate": "bun scripts/generate-place-tokens.ts && bun scripts/fetch-wikidata-brands.ts && bun scripts/build-merchant-dictionary.ts",
    "build:places": "bun scripts/generate-place-tokens.ts",
    "generate:key": "bun scripts/generate-signing-key.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@freenary/auth": "workspace:*",
    "@freenary/db": "workspace:*",
    "@freenary/email": "workspace:*",
    "@freenary/env": "workspace:*",
    "@freenary/instance-config": "workspace:*",
    "@openuidev/lang-core": "0.2.17",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "ai": "^7.0.62",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "effect": "catalog:",
    "evlog": "catalog:",
    "fflate": "^0.8.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@freenary/config": "workspace:*",
    "elysia": "catalog:",
    "typescript": "catalog:"
  }
}
